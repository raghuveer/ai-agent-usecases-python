# Gateway base URL — Anthropic surface. NOTE: no trailing /v1 here (unlike the
# other three approaches). The Agent SDK appends /v1/messages itself.
# Unset / comment out to talk to api.anthropic.com directly instead.
LLM_BASE_URL=http://localhost:8094
# Platform virtual key (sk-aiup-...). Sent as `Authorization: Bearer`.
LLM_GATEWAY_KEY=replace-with-platform-virtual-key
# Allow-listed model alias. claude-haiku is the default; claude-sonnet for the
# harder agentic use cases. Local Qwen aliases cannot drive this SDK — see README.
LLM_MODEL=claude-haiku

# Agent-loop budget caps. An agent loop makes an unbounded number of model
# calls, so both caps are always set.
AGENT_MAX_TURNS=12
AGENT_MAX_BUDGET_USD=1.00
AGENT_EFFORT=low

# Shell sandboxing (F9 in docs/security-review.md). This is the only project in
# the repo that grants `Bash`, and it grants it to a loop driven by request text
# you did not write — so it is ON by default. Turning it off is a deliberate act.
# The SDK implements bash sandboxing on macOS/Linux only; every /run response
# reports `sandboxed`, which is observed from the CLI, not assumed from this.
SANDBOX_BASH=true
# The task never needs the network. Denying it removes the exfiltration half of
# a prompt-injection payload.
SANDBOX_ALLOW_NETWORK=false
