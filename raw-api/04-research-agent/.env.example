LLM_BASE_URL=http://localhost:8080/v1
LLM_GATEWAY_KEY=replace-with-platform-virtual-key
# Model alias. Through the gateway (default) use the allow-listed alias
# 'qwen-local-instruct' (free local Qwen) or 'claude-haiku-4-5'. Raw Ollama
# names like 'qwen3:1.7b' work ONLY if LLM_BASE_URL points at Ollama directly.
# NOTE: this use case defaults to claude-haiku-4-5 — the free local Qwen could
# not reliably drive the multi-step text ReAct loop (see README "Model choice").
LLM_MODEL=claude-haiku-4-5
# Generation params (optional). Defaults reproduce current behavior.
# Lower temperature = more deterministic; raise max_tokens for longer output.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=512
AGENT_MAX_STEPS=6
AGENT_TOP_K=3
