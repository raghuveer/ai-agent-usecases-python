# --- Secrets / local environment (NEVER commit) ---
.env
**/.env
.claude/settings.local.json
# (.env.example IS committed — the exact ".env" pattern above does not match it)

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# NOTE: uv.lock is deliberately COMMITTED for every project — each one is
# installed with `uv sync`, so the lockfile is what pins the dependency set.
# Do not add it here.

# --- Virtual environments ---
.venv/
**/.venv/
venv/
env/

