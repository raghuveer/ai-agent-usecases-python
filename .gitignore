# --- Secrets / local environment (NEVER commit) ---
.env
**/.env
.claude/settings.local.json
# (.env.example IS committed — the exact ".env" pattern above does not match it)

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- uv resolver artifacts ---
# Every project installs with `uv pip install -e .` (see each README), which does
# not read uv.lock. A stray lockfile only drifts from pyproject.toml.
uv.lock
**/uv.lock

# --- Virtual environments ---
.venv/
**/.venv/
venv/
env/

# --- Vector stores / databases / build artifacts ---
.chroma/
**/.chroma/
*.db
*.sqlite
*.sqlite3

# --- Internal planning notes (not for the public repo) ---
ai-usecases-notes.txt

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
