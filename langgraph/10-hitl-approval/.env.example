LLM_BASE_URL=http://localhost:8094/v1
LLM_GATEWAY_KEY=replace-with-platform-virtual-key
# Model alias. Through the gateway (default) use the allow-listed alias
# 'qwen-local-instruct' (free local Qwen) or 'claude-haiku'. Raw Ollama
# names like 'qwen3:1.7b' work ONLY if LLM_BASE_URL points at Ollama directly.
LLM_MODEL=qwen-local-instruct
# Generation params (optional). Defaults reproduce current behavior.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=256

# --- Tracing (see docs/trace-format.md) ---
# `POST /run?trace=1` always returns the trace inline; this only controls disk.
# none = nothing written (default) | file = traces/<run_id>.json + runs.jsonl
TRACE_SINK=none
TRACE_DIR=traces
# Traces embed the prompt, so they contain whatever the caller sent.
# Set 0 to keep spans, timings and token counts but drop message content.
TRACE_INCLUDE_PROMPTS=1
